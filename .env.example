# Server only. Copy to repository-root .env; never commit real values.
# Or select an existing file with UGOKU_ENV_FILE=/absolute/private/path.env.
# Existing process variables take precedence; .env.local is not loaded.
GEMINI_API_KEY=
# Default: gemini-3.8-flash (stable, checked 2026-10-04).
# For a live test, explicitly set the model after reviewing docs/live-gemini.md.
GEMINI_MODEL=
# Default: none. Only this selects/enables a provider: none | ollama | gemini.
# Legacy AI_ENABLED is ignored; stored Gemini keys never select a provider.
AI_PROVIDER=
# Required for ollama: explicit loopback URL, e.g. http://127.0.0.1:11434
OLLAMA_BASE_URL=
# Required for ollama: exact local tag, e.g. gemma4:e2b-it-qat. Never :cloud.
OLLAMA_MODEL=
# Optional pinned full SHA-256 manifest digest; no automatic download.
OLLAMA_MODEL_DIGEST=
# Default: 8192 tokens; bounded 2048..32768. Full history never truncated.
OLLAMA_CONTEXT_LENGTH=
# Default: native. json-actions is an explicit schema-action alternative.
OLLAMA_TOOL_MODE=
# Use a separate random secret of at least 32 characters. Not the Gemini API key.
AI_ACCESS_SECRET=
# Default: 6 model calls per run.
AI_MAX_MODEL_CALLS=
# Default: 12 local tool calls per run.
AI_MAX_TOOL_CALLS=
# Default: 65536 UTF-8 JSON bytes per model request, not an exact token count.
# Includes full model history, system instruction, tool declarations, and settings.
AI_MAX_INPUT_BYTES=
# Default: 1024 output tokens for ollama, 4096 for gemini.
AI_MAX_OUTPUT_TOKENS=
# Default: 90000 milliseconds per run.
AI_TIMEOUT_MS=
# Default: 1 simultaneous run.
AI_MAX_CONCURRENT=
# Default: 60 runs per hour, per server instance.
AI_MAX_RUNS_PER_HOUR=
# Default: 6 runs per minute, per server instance.
AI_RUNS_PER_MINUTE=
# Default: 3001.
PORT=
# Keep unset here. Authorization must be explicit for the live command invocation.
LIVE_API_AUTHORIZED=
